{
  // Run configurations for VS Code (Run and Debug panel, or F5).
  // Each one reads its environment from apps/<app>/config/<env>.json.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Admin · dev (Chrome, local backend)",
      "type": "dart",
      "request": "launch",
      "cwd": "apps/admin",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "args": ["--dart-define-from-file=config/dev.json", "--web-port=8080"]
    },
    {
      "name": "Admin · staging (Chrome)",
      "type": "dart",
      "request": "launch",
      "cwd": "apps/admin",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "args": ["--dart-define-from-file=config/staging.json", "--web-port=8080"]
    },
    {
      "name": "Business · dev (local backend)",
      "type": "dart",
      "request": "launch",
      "cwd": "apps/business",
      "program": "lib/main.dart",
      "args": ["--dart-define-from-file=config/dev.json"]
    },
    {
      "name": "Business · dev · profile (performance)",
      "type": "dart",
      "request": "launch",
      "cwd": "apps/business",
      "program": "lib/main.dart",
      "flutterMode": "profile",
      "args": ["--dart-define-from-file=config/dev.json"]
    },
    {
      "name": "Business · staging",
      "type": "dart",
      "request": "launch",
      "cwd": "apps/business",
      "program": "lib/main.dart",
      "args": ["--dart-define-from-file=config/staging.json"]
    },
    {
      "name": "Business · prod (release, no dev menu)",
      "type": "dart",
      "request": "launch",
      "cwd": "apps/business",
      "program": "lib/main.dart",
      "flutterMode": "release",
      "args": ["--dart-define-from-file=config/prod.json"]
    }
  ]
}
